set -e

husky_color=$(tput setaf 117)
husky_reset=$'\e[0m'

# Run Prettier
echo "${husky_color}Running Prettier ...${husky_reset}"
npm run prettier:check || { echo "Error: Prettier check failed. Did you forget to run Prettier?" >&2; exit 1; }

# Run Linters
echo "${husky_color}Running Linters ...${husky_reset}"
npm run lint || { echo "Error: Linters failed." >&2; exit 1; }

# Commit changes
echo "${husky_color}Committing changes ...${husky_reset}"

exit 0
